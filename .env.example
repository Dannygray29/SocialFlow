# SocialFlow environment template
# Copy to .env locally. Never commit real credentials.

# ── AI provider ──────────────────────────────────────────────────────────────
# Supported: ollama | openai | anthropic | gemini
AI_PROVIDER=ollama

# Cloud AI credentials (only set the one required by AI_PROVIDER)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Local Ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# ── Image generation ─────────────────────────────────────────────────────────
# Requires an OpenAI API key when using a hosted image provider.
IMAGE_MODEL=gpt-image-1.5

# ── Optional visual/video integrations ───────────────────────────────────────
# KLING_API_KEY=
# HEYGEN_EMAIL=
# HEYGEN_PASSWORD=

# ── Browser automation ───────────────────────────────────────────────────────
# false is recommended while establishing a browser session.
HEADLESS=false

# ── Application security ─────────────────────────────────────────────────────
# Required for X OAuth state signing and token encryption in deployed setups.
# Generate a long random value; do not reuse it across unrelated applications.
SOCIALFLOW_SECRET_KEY=

# ── X OAuth 2.0 ──────────────────────────────────────────────────────────────
# Configure these only when enabling X integration.
X_CLIENT_ID=
X_CLIENT_SECRET=
# Must exactly match the callback configured with X.
X_REDIRECT_URI=http://localhost:8000/api/x/callback
